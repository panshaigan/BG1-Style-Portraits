ACTION_IF (infinityui = 1) BEGIN
  OUTER_TEXT_SPRINT portrait_list ~UI.MENU~
END
ELSE BEGIN
  OUTER_TEXT_SPRINT portrait_list ~BGEE.LUA~
END

ACTION_PHP_EACH npc_portraits AS portrait => _ BEGIN
  COPY_EXISTING ~%portrait_list%~ ~override~
    // No ^ anchor: WeiDU regexp ^ is start-of-file only, not start-of-line
    REPLACE_TEXTUALLY ~[ %TAB%]*{'%portrait%',[ %TAB%]+[12]+},[%LNL%%WNL%]*~ ~~
    REPLACE_TEXTUALLY ~[ %TAB%]*{'%portrait%',[ %TAB%]+[12]+}[%LNL%%WNL%]*~ ~~
  BUT_ONLY
END
