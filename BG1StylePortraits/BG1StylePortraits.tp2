BACKUP ~weidu_external/backup/BG1StylePortraits~
AUTHOR ~shaigan~
VERSION ~0.8.2~

LANGUAGE ~English~
         ~english~
         ~BG1StylePortraits/tra/english/setup.tra~


//
// --- PC Portraits ---
//
BEGIN @1001 // Replace PC Portraits
  REQUIRE_PREDICATE (GAME_IS ~bgee bg2ee eet~) @1
  REQUIRE_PREDICATE (
    (RESOURCE_CONTAINS ~UI.MENU~ ~rgGetGameEnginePortraits~)
    OR (RESOURCE_CONTAINS ~BGEE.LUA~ ~portraits~)
  ) @2
  DESIGNATED 1001
  LABEL ~sha_BG1StylePortraits_PC_Portraits~

  INCLUDE ~%MOD_FOLDER%/lib/detect_ui.tph~
  INCLUDE ~%MOD_FOLDER%/lib/pc_portraits.tph~

//
// --- NPC Portraits ---
//
BEGIN @2001 // Enhanced BG1 NPC Portraits
  REQUIRE_PREDICATE GAME_IS ~bgee bg2ee eet~ @1
  GROUP @2000 // Party NPC Portraits
  DESIGNATED 2001
  LABEL ~sha_BG1StylePortraits_EnhancedBG1~
  
  COPY ~%MOD_FOLDER%/portraits/party_bg1~ ~override~

BEGIN @2101 // New BG2 NPC Portraits
  REQUIRE_PREDICATE GAME_IS ~bg2ee eet~ @1
  GROUP @2000 // Party NPC Portraits
  DESIGNATED 2101
  LABEL ~sha_BG1StylePortraits_EnhancedBG2~

  COPY ~%MOD_FOLDER%/portraits/party_bg2~ ~override~
  COPY ~%MOD_FOLDER%/portraits/party_bg2_special~ ~override~

  INCLUDE ~%MOD_FOLDER%/lib/edwina.tph~
  INCLUDE ~%MOD_FOLDER%/lib/bd_npc_portrait_patches.tph~

BEGIN @2201 // Mods: Returning NPC Portraits
  REQUIRE_PREDICATE GAME_IS ~bg2ee eet~ @1
  GROUP @2000 // Party NPC Portraits
  DESIGNATED 2201
  LABEL ~sha_BG1StylePortraits_ReturningBG2~

  COPY ~%MOD_FOLDER%/portraits/party_returning_special~ ~override~
  INCLUDE ~%MOD_FOLDER%/lib/returning_npc_portrait_patches.tph~

BEGIN @2301 // Mods: BG1 NPC Portraits
  REQUIRE_PREDICATE GAME_IS ~bgee eet~ @1
  GROUP @2000 // Party NPC Portraits
  DESIGNATED 2301
  LABEL ~sha_BG1StylePortraits_BG1Mods~

  INCLUDE ~%MOD_FOLDER%/lib/bg1_mods_npc_portrait_patches.tph~

BEGIN @2401 // Mods: BG2 NPC Portraits
  REQUIRE_PREDICATE GAME_IS ~bg2ee eet~ @1
  GROUP @2000 // Party NPC Portraits
  DESIGNATED 2401
  LABEL ~sha_BG1StylePortraits_BG2Mods~

  COPY ~%MOD_FOLDER%/portraits/party_bg2_mods_special~ ~override~
  INCLUDE ~%MOD_FOLDER%/lib/bg2_mods_npc_portrait_patches.tph~
